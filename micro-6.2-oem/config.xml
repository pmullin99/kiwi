<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="7.4" name="SL-Micro-6.2-OEM" displayname="SUSE Linux Micro 6.2 OEM">
    <description type="system">
        <author>OEM Engineering</author>
        <contact>support@example.com</contact>
        <specification>SUSE Linux Micro 6.2 OEM Self-Install ISO</specification>
    </description>

    <!-- Base Self-Install Profile -->
    <preferences>
        <version>6.2.0</version>
        <packagemanager>zypper</packagemanager>
        <rpm-check-signatures>true</rpm-check-signatures>
        <locale>en_US</locale>
        <keytable>us</keytable>
        <timezone>UTC</timezone>

        <type image="oem"
              initrd_system="dracut"
              filesystem="btrfs"
              firmware="uefi"
              bootpartition="false"
              bootkernel="custom"
              devicepersistency="by-uuid"
              btrfs_root_is_readonly_snapshot="true"
              btrfs_root_is_snapper_snapshot="true"
              btrfs_quota_groups="true"
              installiso="true"
              installstick="false"
              kernelcmdline="security=selinux selinux=1 enforcing=1 systemd.firstboot=off console=ttyS0,115200 console=tty0">
            <bootloader name="grub2" console="gfxterm" timeout="5"/>
            <size unit="G">20</size>
            <oemconfig>
                <oem-swap>false</oem-swap>
                <oem-multipath-scan>true</oem-multipath-scan>
                <oem-resize>true</oem-resize>
                <oem-silent-boot>false</oem-silent-boot>
                <oem-unattended>false</oem-unattended>
                <oem-boot-title>SUSE Linux Micro 6.2</oem-boot-title>
            </oemconfig>
            <systemdisk>
                <volume name="@"/>
                <volume name="home"/>
                <volume name="opt"/>
                <volume name="root"/>
                <volume name="srv"/>
                <volume name="tmp"/>
                <volume name="usr/local"/>
                <volume name="var" copy_on_write="false"/>
            </systemdisk>
        </type>
    </preferences>

    <!-- Core Packages Required for SLE Micro 6.2 OEM ISO -->
    <packages type="image" patternType="onlyRequired">
        <package name="SL-Micro-release"/>
        <package name="patterns-base-base"/>
        <package name="patterns-base-basesystem"/>
        <package name="patterns-micro-defaults"/>
        <package name="patterns-micro-hardware"/>
        <package name="patterns-base-selinux"/>
        <package name="kernel-default"/>
        <package name="grub2"/>
        <package name="grub2-x86_64-efi" arch="x86_64"/>
        <package name="grub2-arm64-efi" arch="aarch64"/>
        <package name="shim" arch="x86_64"/>
        <package name="efibootmgr"/>
        <package name="btrfsprogs"/>
        <package name="snapper"/>
        <package name="transactional-update"/>
        <package name="ignition"/>
        <package name="combustion"/>
        <package name="jeos-firstboot"/>
        <package name="podman"/>
        <package name="NetworkManager"/>
        <package name="chrony"/>
        <package name="openssh"/>
        <package name="dracut-kiwi-oem-repart"/>
        <package name="dracut-kiwi-oem-dump"/>
        <package name="multipath-tools"/>
        <package name="dracut-kiwi-lib"/>
        <package name="kpartx"/>
        <package name="kbd"/>
        <package name="binutils"/>
        <package name="sg3_utils"/>
        <package name="udev"/>
    </packages>

    <!-- Bootstrap Packages -->
    <packages type="bootstrap">
        <package name="filesystem"/>
        <package name="glibc-locale-base"/>
        <package name="SL-Micro-release"/>
        <package name="ca-certificates-mozilla"/>
        <package name="multipath-tools"/>
    </packages>
</image>